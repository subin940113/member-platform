# 로컬 실행 예시. 이 파일을 복사해 `.env`로 저장한 뒤 값을 채우고,
# `set -a && source .env && set +a` 또는 IDE Run Configuration에 주입하세요.

# ---- Spring DataSource (로컬 애플리케이션) ----
# docker-compose.yml 의 DB/계정/비밀번호와 동일하게 맞춥니다.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/member
SPRING_DATASOURCE_USERNAME=member
SPRING_DATASOURCE_PASSWORD=member

# ---- Redis (회원 상태 캐시, 로컬은 docker-compose redis 서비스) ----
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ---- JWT (필수, HS256용 최소 32바이트 ASCII 권장 — 애플리케이션 기동 시 검증) ----
# openssl rand -base64 48
JWT_SECRET=

# ---- 개인정보 암호화와 휴대폰 번호 해시 (필수, 최소 32자 — 애플리케이션 기동 시 검증) ----
# openssl rand -base64 48
APP_CRYPTO_SECRET=
# 필수: 휴대폰 번호 해시 전용 pepper. SECRET과 반드시 다른 값을 사용하세요.
# openssl rand -base64 48
APP_CRYPTO_PHONE_PEPPER=

# 선택: 액세스/리프레시 만료(초). 미설정 시 application.yml 기본(900 / 604800)
# JWT_ACCESS_SECONDS=900
# JWT_REFRESH_SECONDS=604800

# 선택: 로그인 실패 N회 시 계정 잠금과 잠금 유지 시간(Spring Duration 형식, 예: 30m, 1h)
# AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_LOCK_DURATION=30m

# 선택: CORS 허용 Origin(줄바꿈 구분). 미설정 시 application.yml 기본값(http://localhost:3000)
# CORS_ALLOWED_ORIGINS=http://localhost:3000
